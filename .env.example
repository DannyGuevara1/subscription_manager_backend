# Inject real secrets through your deployment platform, never commit them.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://app:replace-me@localhost:5432/subscriptions?connection_limit=10&pool_timeout=5&connect_timeout=5
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:5173
# Required; independent randomly generated values (at least 32 bytes each).
JWT_ACCESS_SECRET=replace-with-random-access-secret
JWT_REFRESH_SECRET=replace-with-random-refresh-secret
JWT_ACCESS_TOKEN_EXPIRES_IN=5m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d
# Required outside NODE_ENV=test. Rates must be initialized before traffic.
APP_ID_OPENEXCHANGERATES=replace-with-provider-key
# Docs remain authenticated when enabled.
ENABLE_API_DOCS=false
